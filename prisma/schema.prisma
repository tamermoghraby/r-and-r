// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Ingredient {
  id               String                   @id @default(cuid())
  name             String                   @unique
  unit             String // e.g. "g", "kg", "piece", "liter"
  currentQuantity  Decimal                  @default(0) @db.Decimal(20, 6)
  costPerUnit      Decimal                  @db.Decimal(20, 6) // purchase cost per unit
  createdAt        DateTime                 @default(now())
  stockHistory     IngredientStockHistory[]
  menuItemRequires MenuItemIngredient[]
  purchases        Purchase[]
}

model IngredientStockHistory {
  id             String     @id @default(cuid())
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId   String
  changeAmount   Decimal    @db.Decimal(20, 6) // + added, - deducted
  reason         String // "purchase", "order_deduction", "adjustment"
  relatedOrder   Order?     @relation(fields: [relatedOrderId], references: [id])
  relatedOrderId String?
  note           String?
  createdAt      DateTime   @default(now())
}

model MenuItem {
  id          String               @id @default(cuid())
  name        String               @unique
  price       Decimal              @db.Decimal(20, 2)
  description String?
  image       String?
  createdAt   DateTime             @default(now())
  recipe      MenuItemIngredient[]
  orderItems  OrderItem[]
}

model MenuItemIngredient {
  id               String     @id @default(cuid())
  menuItem         MenuItem   @relation(fields: [menuItemId], references: [id])
  menuItemId       String
  ingredient       Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId     String
  quantityRequired Decimal    @db.Decimal(20, 6) // amount required for ONE unit of menu item

  @@unique([menuItemId, ingredientId])
}

model Order {
  id                       String                   @id @default(cuid())
  orderDate                DateTime                 @default(now())
  totalPrice               Decimal                  @db.Decimal(20, 2)
  status                   String                   @default("completed") // completed, cancelled, pending
  items                    OrderItem[]
  ingredientStockHistories IngredientStockHistory[]
}

model OrderItem {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(20, 2) // price at time of order (denormalize)
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Decimal  @db.Decimal(20, 2)
  expenseDate DateTime @default(now())
  category    String?
  createdAt   DateTime @default(now())
}

model Purchase {
  id           String     @id @default(cuid())
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId String
  quantity     Decimal    @db.Decimal(20, 6)
  totalCost    Decimal    @db.Decimal(20, 2)
  note         String?
  createdAt    DateTime   @default(now())
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("staff") // admin | staff
  createdAt    DateTime @default(now())
}
